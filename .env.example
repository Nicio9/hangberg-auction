# Copy to .env for LOCAL testing only. On Railway set these as service Variables.
# Never commit a filled-in copy of this file (.env is gitignored).

# Railway sets PORT automatically. Only needed locally.
PORT=3000

# Persistent volume mount path. MUST match the Railway volume mount path.
# Holds auction.db (SQLite) + uploads/. Without a volume, all bids are lost on redeploy.
DATA_DIR=/data

# Your site's real https address. Must match the Railway domain EXACTLY.
# Drives confirmation links in emails, and flips cookies to Secure + enables HSTS.
# If this is wrong, confirmation emails point at localhost and nobody can register.
BASE_URL=https://your-app.up.railway.app

# Comma-separated. Anyone registering with one of these gets the Admin menu.
ADMIN_EMAILS=you@example.org

# Verified sender address from Brevo (Senders & IP -> Senders).
MAIL_FROM_EMAIL=auction@yourdomain.co.za
MAIL_FROM_NAME=Hangberg Educational Trust Auction

# REQUIRED for a public launch. With neither key set, confirmation emails are
# only printed to the server log and no bidder can register or bid.
# Brevo (free, 300/day): https://www.brevo.com  -> SMTP & API -> API keys
BREVO_API_KEY=
# Or use Resend instead (free, 100/day) - set RESEND_API_KEY and clear the line above.
# RESEND_API_KEY=
